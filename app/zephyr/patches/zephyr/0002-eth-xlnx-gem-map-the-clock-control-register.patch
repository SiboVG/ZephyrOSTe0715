diff --git a/drivers/ethernet/eth_xlnx_gem.c b/drivers/ethernet/eth_xlnx_gem.c
index 135b6825..bb206e7d 100644
--- a/drivers/ethernet/eth_xlnx_gem.c
+++ b/drivers/ethernet/eth_xlnx_gem.c
@@ -21,6 +21,7 @@
 #include <zephyr/devicetree.h>
 #include <zephyr/sys/__assert.h>
 #include <zephyr/cache.h>
+#include <zephyr/sys/device_mmio.h>
 
 #include <zephyr/net/net_if.h>
 #include <zephyr/net/ethernet.h>
@@ -120,8 +121,17 @@ DT_INST_FOREACH_STATUS_OKAY(ETH_XLNX_GEM_BUFFER_SIZE_CHECK)
 static int eth_xlnx_gem_dev_init(const struct device *dev)
 {
 	const struct eth_xlnx_gem_dev_cfg *dev_conf = dev->config;
+	struct eth_xlnx_gem_dev_data *dev_data = dev->data;
 	uint32_t reg_val;
 
+	/*
+	 * The clock control register lies outside the GEM's register block
+	 * (SLCR / CRL_APB), which the SoC does not map flat: map it, as an
+	 * access through its physical address faults behind an MMU.
+	 */
+	device_map(&dev_data->clk_ctrl_reg, dev_conf->clk_ctrl_reg_address,
+		   sizeof(uint32_t), K_MEM_CACHE_NONE);
+
 	/* Precondition checks using assertions */
 	/* Valid PHY address and polling interval, if PHY is to be managed */
 	if (dev_conf->init_phy) {
@@ -913,7 +923,7 @@ static void eth_xlnx_gem_configure_clocks(const struct device *dev)
 	 * Unlock CRL_APB write access if the write protect bit
 	 * is currently set, restore it afterwards.
 	 */
-	clk_ctrl_reg  = sys_read32(dev_conf->clk_ctrl_reg_address);
+	clk_ctrl_reg  = sys_read32(dev_data->clk_ctrl_reg);
 	clk_ctrl_reg &= ~((ETH_XLNX_CRL_APB_GEMX_REF_CTRL_DIVISOR_MASK <<
 			ETH_XLNX_CRL_APB_GEMX_REF_CTRL_DIVISOR0_SHIFT) |
 			(ETH_XLNX_CRL_APB_GEMX_REF_CTRL_DIVISOR_MASK <<
@@ -934,12 +944,12 @@ static void eth_xlnx_gem_configure_clocks(const struct device *dev)
 		sys_write32((tmp & ~ETH_XLNX_CRL_APB_WPROT_BIT),
 			    ETH_XLNX_CRL_APB_WPROT_REGISTER_ADDRESS);
 	}
-	sys_write32(clk_ctrl_reg, dev_conf->clk_ctrl_reg_address);
+	sys_write32(clk_ctrl_reg, dev_data->clk_ctrl_reg);
 	if ((tmp & ETH_XLNX_CRL_APB_WPROT_BIT) > 0) {
 		sys_write32(tmp, ETH_XLNX_CRL_APB_WPROT_REGISTER_ADDRESS);
 	}
 # elif defined(CONFIG_SOC_FAMILY_XILINX_ZYNQ7000)
-	clk_ctrl_reg  = sys_read32(dev_conf->clk_ctrl_reg_address);
+	clk_ctrl_reg  = sys_read32(dev_data->clk_ctrl_reg);
 	clk_ctrl_reg &= ~((ETH_XLNX_SLCR_GEMX_CLK_CTRL_DIVISOR_MASK <<
 			ETH_XLNX_SLCR_GEMX_CLK_CTRL_DIVISOR0_SHIFT) |
 			(ETH_XLNX_SLCR_GEMX_CLK_CTRL_DIVISOR_MASK <<
@@ -949,7 +959,7 @@ static void eth_xlnx_gem_configure_clocks(const struct device *dev)
 			((div1 & ETH_XLNX_SLCR_GEMX_CLK_CTRL_DIVISOR_MASK) <<
 			ETH_XLNX_SLCR_GEMX_CLK_CTRL_DIVISOR1_SHIFT);
 
-	sys_write32(clk_ctrl_reg, dev_conf->clk_ctrl_reg_address);
+	sys_write32(clk_ctrl_reg, dev_data->clk_ctrl_reg);
 #endif /* CONFIG_SOC_XILINX_ZYNQMP / CONFIG_SOC_FAMILY_XILINX_ZYNQ7000 */
 
 	LOG_DBG("%s set clock dividers div0/1 %u/%u for target "
diff --git a/drivers/ethernet/eth_xlnx_gem_priv.h b/drivers/ethernet/eth_xlnx_gem_priv.h
index ebb59b2d..0728e71f 100644
--- a/drivers/ethernet/eth_xlnx_gem_priv.h
+++ b/drivers/ethernet/eth_xlnx_gem_priv.h
@@ -770,6 +770,7 @@ struct eth_xlnx_gem_dev_cfg {
  */
 struct eth_xlnx_gem_dev_data {
 	struct net_if			*iface;
+	mm_reg_t			clk_ctrl_reg;	/* mapped clk_ctrl_reg_address */
 	uint8_t				mac_addr[6];
 	enum eth_xlnx_link_speed	eff_link_speed;
 
