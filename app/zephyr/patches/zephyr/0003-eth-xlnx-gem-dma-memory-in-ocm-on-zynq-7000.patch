diff --git a/drivers/ethernet/eth_xlnx_gem_priv.h b/drivers/ethernet/eth_xlnx_gem_priv.h
--- a/drivers/ethernet/eth_xlnx_gem_priv.h
+++ b/drivers/ethernet/eth_xlnx_gem_priv.h
@@ -507,6 +507,22 @@
 	.first_tx_buffer = NULL\
 };
 
+/*
+ * DMA memory placement. On the Zynq-7000, DDR below 0x80000 is reachable by the
+ * CPUs only, not by the GEM's DMA (UG585, table 4-1), and an image linked to DDR
+ * address 0 has its uncached and data sections there. Whenever the board chooses
+ * an OCM region, place the BD rings and the packet buffers in the OCM instead:
+ * uncached and reachable by every bus master, as before the ZynqMP DMA rework.
+ */
+#if defined(CONFIG_SOC_FAMILY_XILINX_ZYNQ7000) && \
+	DT_NODE_HAS_STATUS_OKAY(DT_CHOSEN(zephyr_ocm))
+#define ETH_XLNX_GEM_BD_RINGS_SECTION __ocm_bss_section
+#define ETH_XLNX_GEM_DMA_AREA_SECTION __ocm_bss_section
+#else
+#define ETH_XLNX_GEM_BD_RINGS_SECTION __nocache
+#define ETH_XLNX_GEM_DMA_AREA_SECTION
+#endif
+
 /* Buffer descriptor rings declaration macro */
 #define ETH_XLNX_GEM_BD_RINGS_DECL(port) \
 struct eth_xlnx_gem##port##_bd_rings_layout {\
@@ -518,7 +534,8 @@
 
 /* Buffer descriptor rings instantiation macro */
 #define ETH_XLNX_GEM_BD_RINGS_INST(port) \
-__nocache static struct eth_xlnx_gem##port##_bd_rings_layout eth_xlnx_gem##port##_bd_rings;
+ETH_XLNX_GEM_BD_RINGS_SECTION static struct eth_xlnx_gem##port##_bd_rings_layout\
+	eth_xlnx_gem##port##_bd_rings;
 
 /* DMA memory area declaration macro */
 #define ETH_XLNX_GEM_DMA_AREA_DECL(port) \
@@ -544,7 +561,7 @@
 /* DMA memory area instantiation macro */
 #define ETH_XLNX_GEM_DMA_AREA_INST(port) \
 static struct eth_xlnx_gem##port##_dma_area_layout eth_xlnx_gem##port##_dma_area\
-	__aligned(4096);
+	ETH_XLNX_GEM_DMA_AREA_SECTION __aligned(4096);
 
 /* Interrupt configuration function macro */
 #define ETH_XLNX_GEM_CONFIG_IRQ_FUNC(port) \
