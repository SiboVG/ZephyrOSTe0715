#
# Writes OUT, a header with the git revisions of the bench (BENCH) and of the library
# under test (LIBRARY), as BENCH_REVISION and LIBRARY_REVISION. Runs at every build and
# rewrites the header only when a revision changed, so the banner never shows a stale
# revision. Usage: cmake -DOUT=... -DBENCH=... -DLIBRARY=... -P revision.cmake

function(describe directory result)
    execute_process(
        COMMAND git -C "${directory}" describe --always --dirty --abbrev=12
        OUTPUT_VARIABLE revision
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE status)
    if(NOT status EQUAL 0 OR revision STREQUAL "")
        set(revision "unknown")
    endif()
    set(${result} "${revision}" PARENT_SCOPE)
endfunction()

describe("${BENCH}" bench)
describe("${LIBRARY}" library)
set(content "/* Generated by fprime-bench/cmake/revision.cmake */\n#define BENCH_REVISION \"${bench}\"\n#define LIBRARY_REVISION \"${library}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
