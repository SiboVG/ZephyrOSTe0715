mainmenu "INA229 bench on the TE0715"

config APP_SPI_FREQUENCY
	int "Requested SPI clock in Hz at boot"
	range 558035 10000000
	default 1200000
	help
	  The Zynq SPI controller divides SPI_REF_CLK (142.86 MHz) by 4 to 256;
	  the driver picks the fastest division that does not exceed this
	  request. 1.2 MHz selects 1.116 MHz. Change it at run time with
	  `ina spi`.

config APP_SPI_MODE
	int "SPI mode at boot"
	range 0 3
	default 3
	help
	  SPI mode 3 (CPOL 1, CPHA 1), the only mode in which every register
	  write reached the INA229 on this bench (2026-10-04). In modes 1 and 2
	  reads pass but some writes are silently lost, depending on the data
	  bits; mode 0 breaks reads (docs/known-issues.md). Change it at run
	  time with `ina spi`.

source "Kconfig.zephyr"
