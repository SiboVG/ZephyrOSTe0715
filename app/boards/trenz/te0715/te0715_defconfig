CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Apply MIO pin configuration from devicetree (instead of relying on the FSBL)
CONFIG_PINCTRL=y

# System clock: the GTC runs at 1/2 of the 666.67 MHz CPU clock
CONFIG_ARM_ARCH_TIMER=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=333333333

