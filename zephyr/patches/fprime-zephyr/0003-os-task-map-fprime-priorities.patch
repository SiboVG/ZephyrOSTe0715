diff --git a/fprime-zephyr/Os/Task.cpp b/fprime-zephyr/Os/Task.cpp
--- a/fprime-zephyr/Os/Task.cpp
+++ b/fprime-zephyr/Os/Task.cpp
@@ -36,20 +36,29 @@
                                 : static_cast<size_t>(arguments.m_stackSize);
 
         k_thread_stack_t *stack = k_thread_stack_alloc(stack_size, 0);
-        FwSizeType priority = arguments.m_priority;
 
         if (stack == nullptr) {
             return Os::Task::Status::ERROR_RESOURCES;
         }
 
-        // Zephyr priroties range from -16 to +14
-        if (priority > 14) {
-            if (arguments.m_priority != Os::Task::TASK_PRIORITY_DEFAULT) {
-                Fw::Logger::log("Priority of %" PRI_FwSizeType " exceeds maximum value. Setting to a priority value of 14.\n",
-                                priority);
+        // F Prime: a higher value is a higher priority. Zephyr preemptible threads:
+        // 0 is the highest and CONFIG_NUM_PREEMPT_PRIORITIES - 1 the lowest. Map F Prime
+        // priority p to (N - 1) - p, so the order and the distance between priorities are
+        // kept for p < N; higher values saturate at the highest preemptible priority.
+        // TASK_PRIORITY_DEFAULT is the lowest preemptible priority.
+        constexpr FwTaskPriorityType lowest = static_cast<FwTaskPriorityType>(CONFIG_NUM_PREEMPT_PRIORITIES - 1);
+        FwTaskPriorityType fprime_priority = 0;
+        if (arguments.m_priority != Os::Task::TASK_PRIORITY_DEFAULT) {
+            fprime_priority = arguments.m_priority;
+            if (fprime_priority > lowest) {
+                Fw::Logger::log("Task %s: priority %" PRI_FwTaskPriorityType
+                                " exceeds CONFIG_NUM_PREEMPT_PRIORITIES - 1 = %" PRI_FwTaskPriorityType
+                                ", using the highest preemptible priority\n",
+                                arguments.m_name.toChar(), fprime_priority, lowest);
+                fprime_priority = lowest;
             }
-            priority = 14;
         }
+        const int priority = static_cast<int>(lowest - fprime_priority);
 
         k_tid_t tid = k_thread_create(&this->m_handle.m_task_descriptor, stack, stack_size, zephyrEntryWrapper, arguments.m_routine_argument, nullptr, nullptr, priority, 0, K_NO_WAIT);
 
