{
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/demo/static-analysis/compile_commands.json",
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "C_Cpp.codeAnalysis.clangTidy.path": "${workspaceFolder}/app/scripts/clang-tidy",
    "C_Cpp.codeAnalysis.clangTidy.useBuildPath": true,
    "C_Cpp.codeAnalysis.clangTidy.args": [
        "--extra-arg=--target=arm-none-eabi",
        "--extra-arg=--system-header-prefix=zephyr/",
        "--extra-arg=-Wno-unknown-warning-option"
    ],
    "C_Cpp.codeAnalysis.runAutomatically": true,
    "C_Cpp.codeAnalysis.exclude": {
        "zephyr/**": true,
        "zephyr-spi-main/**": true,
        "modules/**": true,
        "build/**": true,
        "twister-*/**": true
    }
}
